# Google Form — apply modal posts here; link the form to a Google Sheet in Form → Responses.
# Full formResponse URL, e.g. https://docs.google.com/forms/d/e/FORM_ID_HERE/formResponse
NEXT_PUBLIC_GOOGLE_FORM_ACTION_URL=

# Field names from the form HTML (e.g. entry.1234567890), one per question, in order:
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_NAME=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_PHONE=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_CITY=
# Optional — 12th stream; omit if your Google Form has no such question
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_STREAM=
